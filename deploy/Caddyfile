# Caddyfile — Band Metronome tự host trên Ubuntu.
# setup-ubuntu.sh thay domain trong file này bằng biến DOMAIN.
#
# MODE A (mặc định, máy có IP công cộng + port 80/443 tới được từ internet):
#   Caddy tự xin & gia hạn chứng chỉ Let's Encrypt qua ACME HTTP-01.
# MODE B (đằng sau Cloudflare Tunnel — dùng khi ISP chặn/không có port mở):
#   đổi dòng site thành  :8080 {   và chạy
#   cloudflared tunnel --url http://127.0.0.1:8080
#   (browser <-> Cloudflare là HTTPS; Cloudflare <-> máy bạn đi trong tunnel đã mã hoá)

band-metronome.lichinhhien.id.vn {
	encode zstd gzip

	# app.py đã tự gởi Content-Security-Policy + nosniff + Referrer-Policy cho mọi
	# response (smoke_test.py kiểm tra). Caddy KHÔNG đặt lại: hai header CSP cùng lúc
	# sẽ bị trình duyệt ép đồng thời cả hai, dễ làm hỏng tính năng.
	# Caddy chỉ thêm phần mà app không tự có: bắt buộc HTTPS.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Flask đã có trần MAX_BODY_KB; chặn sớm ở edge cho đỡ tốn tiến trình
	request_body {
		max_size 1MB
	}

	# Caddy tự thêm X-Forwarded-For; ProxyFix(x_for=1) trong app.py lấy giá trị rightmost
	# -> IP mà rate-limit nhìn thấy là IP thật của khách.
	reverse_proxy 127.0.0.1:8000
}

# Log: Caddy ghi stdout -> journalctl -u caddy -f
