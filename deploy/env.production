# Biến môi trường production của Band Metronome — copy tới /etc/band-metronome/env
# Định dạng systemd EnvironmentFile: KEY=VALUE, không dùng "export", không có space quanh "=".

# --- Đường dẫn dữ liệu (ngoài mã nguồn để git pull không đụng tới) ---
OUT_DIR=/var/lib/band-metronome/output
HISTORY_DB=/var/lib/band-metronome/history.db

# --- Chỉ có ý nghĩa khi chạy `python app.py`; gunicorn bind theo ExecStart của unit ---
HOST=127.0.0.1
PORT=8000

# --- Bắt buộc là 0 trên internet: debug=True = RCE qua Werkzeug console ---
FLASK_DEBUG=0

# --- Trần chống lạm dụng (app public, không mật khẩu) ---
# Thời lượng WAV tối đa mỗi bài (giây) = 30 phút
MAX_SONG_SECONDS=1800
# Số bài render đồng thời. RAM đỉnh mỗi job ~290 MB (bài 600 s, 48 kHz),
# ~900 MB cho bài dài nhất cho phép (30 phút). MAX_JOBS=2 -> dưới 2 GB.
# Máy 12 GB có thể đặt 3-4; đừng đặt cao hơn nếu không hạ MAX_SONG_SECONDS.
MAX_JOBS=2
# Số lần render / 1 giờ / 1 IP
GENS_PER_HOUR=20
# Trần dung lượng thư mục output (MB). Vượt trần -> xoá file lâu nhất dùng (LRU).
DISK_CAP_MB=5120
# Trần body JSON gửi lên (KB) — đủ cho 100 đoạn, chặn body khổng lồ
MAX_BODY_KB=512
