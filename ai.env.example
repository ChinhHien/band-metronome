# Cau hinh van hanh cua tinh nang AI doc bo cuc bai hat (ai_layout/).
# File nay KHONG con chua secret nao — API key / base URL / model la cua tung thiet bi,
# nguoi dung nhap tren web va chi nam trong trinh duyệt cua ho.
# Bien moi truong that (systemd EnvironmentFile, export) luon thang file nay.
# Bo ai.env cung duoc: thieu AI_LAYOUT_ENABLED=1 la /api/ai/* tra 503.

# --- cong tac ---
AI_LAYOUT_ENABLED=1

# --- chat luong goi model ---
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4000
# json_object | none — provider khong ho tro response_format thi dat none
AI_RESPONSE_FORMAT=json_object
# Giay cho mot luot goi model (bai dai can nhieu thoi gian hon)
AI_TIMEOUT_S=180

# --- am thanh gui len model ---
# Tran dung luong toi nguoi dung tai len (MB)
AI_MAX_UPLOAD_MB=25
# Tran thoi luong bai nghe (giay) — chi ap dung cho WAV vi doc duoc header
AI_MAX_ANALYZE_SECONDS=1200
# WAV duoc ha xuong mono o sample rate nay truoc khi gui (khong can FFmpeg)
AI_WAV_TARGET_SR=16000

# --- an toàn mạng khi server gọi tới URL do người dùng nhập ---
# Danh sách host được phép, phân tách bằng dau phay. De trong = moi host công khai qua https
# (van bi chan IP noi bo / 169.254.169.254). Nen khoa danh sách khi deploy.
AI_ALLOWED_HOSTS=

# --- chong spam ---
AI_MAX_JOBS=1
AI_JOBS_PER_HOUR=10
